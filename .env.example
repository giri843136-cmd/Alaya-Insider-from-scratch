# ===========================================
# ALAYA INSIDER — Production Environment
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# --- Application ---
NEXT_PUBLIC_SITE_URL=https://alayainsider.com
NEXT_PUBLIC_SITE_NAME=Alaya Insider

# --- Database ---
DATABASE_PATH=./data/alaya.db

# --- Authentication ---
# REQUIRED: Change this to a random 64+ character string
AUTH_SECRET=CHANGE-ME-generate-a-long-random-secret-string-minimum-64-characters
JWT_EXPIRY=7d

# --- SMTP (Email) ---
# Leave empty to disable email. System will show "Not Configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Alaya Insider
SMTP_FROM_EMAIL=
SMTP_SECURE=true

# --- Analytics ---
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_ANALYTICS_ID=

# --- Upload ---
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads

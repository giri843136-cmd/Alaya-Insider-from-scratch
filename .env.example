# ===========================================
# ALAYA INSIDER — Environment Configuration
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# NEVER push secrets to GitHub.

# --- Application ---
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://alayainsider.com
NEXT_PUBLIC_SITE_NAME=Alaya Insider

# --- Database ---
DATABASE_PATH=./data/alaya.db

# --- Authentication ---
# REQUIRED in production: Generate a cryptographically secure random string (64+ chars)
# Example: openssl rand -base64 48
AUTH_SECRET=
JWT_EXPIRY=7d

# --- Initial Admin Account ---
# Set this ONLY for first-time database initialization.
# The admin user is created once. Remove after first successful login.
ADMIN_SEED_PASSWORD=

# --- SMTP (Email) ---
# Leave empty to disable email features. System reports "Not Configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Alaya Insider
SMTP_FROM_EMAIL=
SMTP_SECURE=true

# --- Analytics ---
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_ANALYTICS_ID=

# --- Upload ---
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads

# --- Amazon Creators API (Live Pricing, dual-store: India + US) ---
# The official replacement for PA-API 5.0 (which Amazon retired 2026-05-15).
# Required for live price fetching. Without these, prices show as
# "Check current price on Amazon" (fallback text-link mode).
#
# Preferred: enter these in Admin -> Amazon API instead of .env — the secret is
# stored encrypted in the database and managed without SSH. If CREATORS_*
# values are set here they are used only when no DB credentials exist.
#
# INDIA store (amazon.in, tag -21, credential version 3.2 / EU token endpoint):
CREATORS_CLIENT_ID=
CREATORS_CLIENT_SECRET=
CREATORS_VERSION=3.2
CREATORS_PARTNER_TAG=alayainsider-21
CREATORS_MARKETPLACE=www.amazon.in
# US store (amazon.com, tag -20, credential version 3.1 / NA token endpoint):
# Optional — until US credentials exist the US tab shows "Not configured" and
# the site runs India-first. Enter via Admin -> Amazon API when available.
CREATORS_US_CLIENT_ID=
CREATORS_US_CLIENT_SECRET=
CREATORS_US_VERSION=3.1
CREATORS_US_PARTNER_TAG=alayainsider-20
CREATORS_US_MARKETPLACE=www.amazon.com
# Optional override for the OAuth2 token endpoint (default derived from version)
# CREATORS_TOKEN_ENDPOINT=https://api.amazon.co.uk/auth/o2/token
# CREATORS_US_TOKEN_ENDPOINT=https://api.amazon.com/auth/o2/token
# Optional log file for Creators API failures (default: ./data/logs/creators-api.log)
# CREATORS_LOG=./data/logs/creators-api.log
# Geo-detection: optional MaxMind GeoLite2 Country DB for the CF-IPCountry
# fallback. Drop the .mmdb file here (e.g. GeoLite2-Country.mmdb) or set the
# path below. Without it, visitors without a CF-IPCountry header default to
# the India store (safe default; OneLink handles other countries).
# GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

# --- Hourly Amazon price refresh (cron) ---
# Secret required to call POST /api/cron/amazon-prices from an external cron
# service (cron-job.org / UptimeRobot) via the x-cron-secret header.
CRON_SECRET=

# --- Security ---
# Optional: Restrict admin panel access to specific IPs (comma-separated)
# Leave empty to allow all IPs (works with dynamic IPs)
# Example: ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
ADMIN_ALLOWED_IPS=

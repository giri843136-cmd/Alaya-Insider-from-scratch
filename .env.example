# Database
DATABASE_PATH=./data/alaya.db

# Authentication
AUTH_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
JWT_EXPIRY=7d

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Alaya Insider

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Analytics (optional)
ANALYTICS_ID=

# Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads
